{
  "cli": {
    "version": ">= 16.17.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "GOOGLE_SERVICES_JSON": "$GOOGLE_SERVICES_JSON",
        "GOOGLE_SERVICES_FILE_IOS": "GOOGLE_SERVICES_PLIST"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "GOOGLE_SERVICES_JSON": "$GOOGLE_SERVICES_JSON",
        "GOOGLE_SERVICES_FILE_IOS": "GOOGLE_SERVICES_PLIST"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "GOOGLE_SERVICES_JSON": "$GOOGLE_SERVICES_JSON",
        "GOOGLE_SERVICES_FILE_IOS": "GOOGLE_SERVICES_PLIST"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
